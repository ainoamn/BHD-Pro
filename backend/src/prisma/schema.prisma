/// Editable subscription plan catalog (prices, limits, feature locks).
model PlanDefinition {
  id            String   @id @default(uuid())
  code          String   @unique
  nameAr        String   @map("name_ar")
  nameEn        String   @map("name_en")
  monthlyPrice  Decimal  @map("monthly_price") @db.Decimal(12, 3)
  yearlyPrice   Decimal  @map("yearly_price") @db.Decimal(12, 3)
  /// Percent off list yearly (monthly × 12). Used to auto-calc yearly from monthly.
  yearlyDiscountPct Decimal @default(20) @map("yearly_discount_pct") @db.Decimal(5, 2)
  invoicesLimit Int      @map("invoices_limit")
  usersLimit    Int      @map("users_limit")
  support       String   @default("email")
  /// Feature flags: accounting, inventory, pos, resto, aiAnalytics, multiBranch, apiKeys, advancedReports
  features      Json
  isActive      Boolean  @default(true) @map("is_active")
  /// System plans (STARTER/PRO/ENT) cannot be deleted — only edited / deactivated
  isSystem      Boolean  @default(false) @map("is_system")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([sortOrder])
  @@map("plan_definitions")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  valueJson Json     @map("value_json")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// Platform console operators (appoint/remove in /admin/operators). Bootstrap emails still always allowed.
model PlatformOperator {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  /// Permission keys: full | overview | tenants | users | billing | plans | visits | gateways | operators
  permissions Json     @default("[\"full\"]")
  isActive    Boolean  @default(true) @map("is_active")
  /// Deputy platform owner — only primary owner may appoint/deactivate
  isDeputy    Boolean  @default(false) @map("is_deputy")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("platform_operators")
}

model PosDraft {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById     String   @map("created_by_id")
  createdBy       User     @relation("PosDraftsCreated", fields: [createdById], references: [id])
  name            String
  notes           String?
  warehouseId     String?  @map("warehouse_id")
  contactId       String?  @map("contact_id")
  linesJson       Json     @map("lines_json") // CartLine[]
  /// Cash/card already taken while cart is parked (deposit-on-hold)
  heldAmount      Decimal? @map("held_amount") @db.Decimal(14, 3)
  /// CASH | CREDIT_CARD | BANK_TRANSFER
  heldMethod      String?  @map("held_method")
  /// PosCashMovement IN id when heldMethod=CASH (drawer expected cash)
  heldMovementId  String?  @map("held_movement_id")
  /// Required reason when parking (chip or free text)
  suspendReason   String?  @map("suspend_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("pos_drafts")
}

/// Async dual-control: cashier requests online manager approval (15 min TTL).
model ApprovalRequest {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  action        String   // DualControlAction value
  status        String   @default("PENDING") // PENDING APPROVED REJECTED CONSUMED EXPIRED
  payloadJson   Json     @map("payload_json") // opaque client context e.g. { invoiceId }
  summary       String?
  requestedById String   @map("requested_by_id")
  requestedBy   User     @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedById   String?  @map("decided_by_id")
  decidedBy     User?    @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  decisionNote  String?  @map("decision_note")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([companyId, status])
  @@map("approval_requests")
}

/// POS cash-drawer shift (open → sell → close + Z-report).
model PosShift {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouseId   String?   @map("warehouse_id")
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  openedById    String    @map("opened_by_id")
  openedBy      User      @relation("PosShiftOpenedBy", fields: [openedById], references: [id])
  closedById    String?   @map("closed_by_id")
  closedBy      User?     @relation("PosShiftClosedBy", fields: [closedById], references: [id])
  status        String    @default("OPEN") // OPEN | CLOSED
  openingFloat  Decimal   @default(0) @map("opening_float") @db.Decimal(14, 3)
  closingCash   Decimal?  @map("closing_cash") @db.Decimal(14, 3)
  /// Counted note/coin breakdown at close: { "50": 2, "10": 5, ... }
  closingDenominationJson Json? @map("closing_denomination_json")
  notes         String?
  zReportJson   Json?     @map("z_report_json")
  openedAt      DateTime  @default(now()) @map("opened_at")
  closedAt      DateTime? @map("closed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  invoices Invoice[]
  cashMovements PosCashMovement[]

  @@index([companyId, status])
  @@index([companyId, openedAt])
  @@map("pos_shifts")
}

/// Paid-in / paid-out cash drawer movements during an open POS shift.
/// type: IN | OUT | NO_SALE (amount 0 audited drawer open)
model PosCashMovement {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shiftId     String   @map("shift_id")
  shift       PosShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  /// IN | OUT
  type        String
  amount      Decimal  @db.Decimal(14, 3)
  reason      String?
  /// GL journal posted for this drawer movement (cash in/out).
  journalId   String?  @map("journal_id")
  journal     Journal? @relation("PosCashMovementJournal", fields: [journalId], references: [id], onDelete: SetNull)
  createdById String   @map("created_by_id")
  createdBy   User     @relation("PosCashMovementCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([companyId, shiftId])
  @@index([shiftId, createdAt])
  @@index([journalId])
  @@map("pos_cash_movements")
}

/// Short-lived WhatsApp OTP for dual-control approvals.
model DualControlOtp {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  action        String
  requestedById String   @map("requested_by_id")
  requestedBy   User     @relation("DualControlOtpRequestedBy", fields: [requestedById], references: [id])
  codeHash      String   @map("code_hash")
  sentTo        String?  @map("sent_to")
  expiresAt     DateTime @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([companyId, action, requestedById])
  @@map("dual_control_otps")
}

/// Monthly / recurring company commitments (rent, salaries schedule, loans, etc.)
model RecurringCommitment {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  /// RENT | SALARY | LOAN | VENDOR | UTILITY | OTHER
  type             String    @default("OTHER")
  amount           Decimal   @default(0)
  currency         String    @default("OMR")
  /// WEEKLY | MONTHLY | QUARTERLY | YEARLY
  frequency        String    @default("MONTHLY")
  nextRunAt        DateTime  @map("next_run_at")
  dayOfMonth       Int?      @map("day_of_month")
  /// ACTIVE | PAUSED | CANCELLED
  status           String    @default("ACTIVE")
  pausedUntil      DateTime? @map("paused_until")
  expenseAccountId String?   @map("expense_account_id")
  payableAccountId String?   @map("payable_account_id")
  bankAccountId    String?   @map("bank_account_id")
  bankAccount      BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  contactId        String?   @map("contact_id")
  notes            String?
  lastRunAt        DateTime? @map("last_run_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([nextRunAt])
  @@index([status])
  @@map("recurring_commitments")
}

/// Polymorphic file attachment metadata (storage_key = local/S3 path or data URL ref)
model Attachment {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  fileName     String   @map("file_name")
  mimeType     String?  @map("mime_type")
  sizeBytes    Int      @default(0) @map("size_bytes")
  storageKey   String   @map("storage_key")
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, entityType, entityId])
  @@map("attachments")
}

/// Admin/manager-only alerts (duplicate refs, suspicious similar txs)
model ManagementAlert {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// DUPLICATE_REFERENCE | SIMILAR_TRANSACTION | PAYROLL_ANOMALY | OTHER
  type         String
  /// LOW | MEDIUM | HIGH
  severity     String    @default("MEDIUM")
  title        String
  message      String
  entityType   String?   @map("entity_type")
  entityId     String?   @map("entity_id")
  payloadJson  Json      @default("{}") @map("payload_json")
  /// OPEN | ACKNOWLEDGED | RESOLVED | DISMISSED
  status       String    @default("OPEN")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([companyId, status])
  @@map("management_alerts")
}

model ManagerReportSubscription {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation("ManagerReportUser", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("ManagerReportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  frequency   ManagerReportFrequency
  channelsJson Json    @default("{}") @map("channels_json")
  lastSentAt  DateTime? @map("last_sent_at")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([companyId, userId, isActive])
  @@index([frequency, isActive])
  @@map("manager_report_subscriptions")
}

/// Customer-reported suspicious POS/invoice transaction (public dispute link)
model CustomerDispute {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId     String   @map("invoice_id")
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  publicCode    String   @map("public_code")
  reason        String
  reporterPhone String?  @map("reporter_phone")
  reporterName  String?  @map("reporter_name")
  /// OPEN | REVIEWED | RESOLVED | DISMISSED
  status        String   @default("OPEN")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([companyId, status])
  @@index([invoiceId])
  @@index([publicCode])
  @@map("customer_disputes")
}

/// Cashier commission EARN / PAYOUT / ADJUST ledger
model CashierCommissionLedger {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation("CashierCommissionUser", fields: [userId], references: [id], onDelete: Cascade)
  invoiceId   String?  @map("invoice_id")
  /// EARN | PAYOUT | ADJUST
  type        String
  amount      Decimal  @db.Decimal(14, 3)
  note        String?
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("CashierCommissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([companyId, userId, createdAt])
  @@map("cashier_commission_ledger")
}

/// Customer loyalty points EARN / REDEEM / ADJUST ledger
model LoyaltyPointsLedger {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId  String   @map("contact_id")
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  invoiceId  String?  @map("invoice_id")
  /// EARN | REDEEM | ADJUST
  type       String
  points     Decimal  @db.Decimal(14, 3)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([companyId, contactId, createdAt])
  @@map("loyalty_points_ledger")
}

// ==================== HISABY RESTAURANTS (F&B) ====================

enum RestoTableStatus {
  FREE
  OCCUPIED
  BILLING
  RESERVED
}

enum RestoOrderStatus {
  OPEN
  SENT
  PARTIAL
  READY
  CLOSED
  CANCELLED
}

enum RestoOrderItemStatus {
  PENDING
  SENT
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum RestoOrderChannel {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

model RestoZone {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  nameEn    String?  @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tables            RestoTable[]
  serverAssignments RestoServerSection[]

  @@index([companyId, sortOrder])
  @@map("resto_zones")
}

/// Active (or historical) server ↔ floor section (zone) for tip pool / floor routing
model RestoServerSection {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation("RestoServerSectionUser", fields: [userId], references: [id], onDelete: Cascade)
  zoneId    String    @map("zone_id")
  zone      RestoZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  startsAt  DateTime  @default(now()) @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([companyId, zoneId, endsAt])
  @@index([companyId, userId, endsAt])
  @@map("resto_server_sections")
}

model RestoTable {
  id        String          @id @default(uuid())
  companyId String          @map("company_id")
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zoneId    String          @map("zone_id")
  zone      RestoZone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  code      String
  name      String?
  seats     Int             @default(4)
  status    RestoTableStatus @default(FREE)
  sortOrder Int             @default(0) @map("sort_order")
  /// Public guest QR token — /order/{token}
  guestToken String?        @unique @map("guest_token")
  /// Guest pressed “call waiter / check” from QR menu
  guestCallAt DateTime?     @map("guest_call_at")
  guestCallType String?     @map("guest_call_type")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  orders RestoOrder[]
  reservations RestoReservation[]

  @@unique([companyId, code])
  @@index([companyId, zoneId, sortOrder])
  @@index([companyId, status])
  @@map("resto_tables")
}

model RestoStation {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  nameEn    String?  @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items            RestoOrderItem[]
  productStations  RestoProductStation[]

  @@index([companyId, sortOrder])
  @@map("resto_stations")
}

/// Default kitchen station per menu product (routing to KDS)
model RestoProductStation {
  id        String       @id @default(uuid())
  companyId String       @map("company_id")
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String       @map("product_id")
  stationId String       @map("station_id")
  station   RestoStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([companyId, productId])
  @@index([companyId, stationId])
  @@map("resto_product_stations")
}

/// Recipe (BOM) for a finished menu dish — components deducted on paid close when dish is not stock-tracked
model RestoRecipe {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  items     RestoRecipeItem[]

  @@unique([companyId, productId])
  @@unique([productId])
  @@index([companyId])
  @@map("resto_recipes")
}

model RestoRecipeItem {
  id                 String      @id @default(uuid())
  recipeId           String      @map("recipe_id")
  recipe             RestoRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  componentProductId String      @map("component_product_id")
  component          Product     @relation("RestoRecipeComponent", fields: [componentProductId], references: [id], onDelete: Restrict)
  qty                Decimal     @db.Decimal(14, 3)
  createdAt          DateTime    @default(now()) @map("created_at")

  @@unique([recipeId, componentProductId])
  @@index([componentProductId])
  @@map("resto_recipe_items")
}

enum RestoReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
  NO_SHOW
}

model RestoReservation {
  id         String                 @id @default(uuid())
  companyId  String                 @map("company_id")
  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tableId    String?                @map("table_id")
  table      RestoTable?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  guestName  String                 @map("guest_name")
  phone      String?
  guests     Int                    @default(2)
  reservedAt DateTime               @map("reserved_at")
  status     RestoReservationStatus @default(PENDING)
  notes      String?
  /// STAFF | GUEST — how the reservation was created
  source     String                 @default("STAFF")
  /// Public confirm/cancel token
  confirmToken   String?   @unique @map("confirm_token")
  confirmedAt    DateTime? @map("confirmed_at")
  reminderSentAt DateTime? @map("reminder_sent_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  @@index([companyId, reservedAt])
  @@index([companyId, status])
  @@map("resto_reservations")
}

model RestoOrder {
  id          String           @id @default(uuid())
  companyId   String           @map("company_id")
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tableId     String?          @map("table_id")
  table       RestoTable?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  number      String
  channel     RestoOrderChannel @default(DINE_IN)
  status      RestoOrderStatus @default(OPEN)
  guests      Int              @default(1)
  notes       String?
  /// Delivery / takeaway guest contact
  guestName   String?          @map("guest_name")
  guestPhone  String?          @map("guest_phone")
  deliveryAddress String?      @map("delivery_address")
  /// QUEUED | KITCHEN | READY | OUT | DELIVERED — delivery channel ops
  deliveryStatus String?       @map("delivery_status")
  driverName  String?          @map("driver_name")
  driverPhone String?          @map("driver_phone")
  deliveredAt DateTime?        @map("delivered_at")
  openedById  String?          @map("opened_by_id")
  openedBy    User?            @relation("RestoOrderOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  /// Who receives tip attribution (may differ from opener / closer)
  tipAssigneeId String?        @map("tip_assignee_id")
  tipAssignee   User?          @relation("RestoOrderTipAssignee", fields: [tipAssigneeId], references: [id], onDelete: SetNull)
  /// Loyalty / CRM contact for points earn on paid close
  contactId   String?          @map("contact_id")
  contact     Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Aggregator / marketplace channel (TALABAT, JAHEZ, CAREEM, DIRECT, …)
  externalChannel String?      @map("external_channel")
  /// Idempotent external order id within channel
  externalOrderId String?      @map("external_order_id")
  /// POS/Accounting invoice created on paid close (R4)
  invoiceId   String?          @map("invoice_id")
  sentAt      DateTime?        @map("sent_at")
  closedAt    DateTime?        @map("closed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  items RestoOrderItem[]

  @@unique([companyId, number])
  @@unique([companyId, externalChannel, externalOrderId])
  @@index([companyId, status, createdAt])
  @@index([companyId, tableId])
  @@index([invoiceId])
  @@index([companyId, tipAssigneeId])
  @@index([companyId, contactId])
  @@map("resto_orders")
}

model RestoOrderItem {
  id         String               @id @default(uuid())
  orderId    String               @map("order_id")
  order      RestoOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?              @map("product_id")
  stationId  String?              @map("station_id")
  station    RestoStation?        @relation(fields: [stationId], references: [id], onDelete: SetNull)
  name       String
  qty        Decimal              @db.Decimal(14, 3)
  unitPrice  Decimal              @map("unit_price") @db.Decimal(14, 3)
  notes      String?
  /// 0=drinks · 1=starter · 2=main · 3=dessert — fire by course to KDS
  course     Int                  @default(1)
  /// 1..order.guests; null = shared / unassigned
  seat       Int?
  /// STAFF | GUEST — guest QR lines auto-fire to kitchen
  source     String               @default("STAFF")
  status     RestoOrderItemStatus @default(PENDING)
  /// KDS rush priority
  isRush     Boolean              @default(false) @map("is_rush")
  /// Non-null = held / parked on KDS (still SENT|PREPARING|READY)
  heldAt     DateTime?            @map("held_at")
  /// Comp = complimentary (zero bill); void = cancelled after send with reason
  isComp     Boolean              @default(false) @map("is_comp")
  voidReason String?              @map("void_reason")
  voidedAt   DateTime?            @map("voided_at")
  voidedById String?              @map("voided_by_id")
  sentAt     DateTime?            @map("sent_at")
  readyAt    DateTime?            @map("ready_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  @@index([orderId, status])
  @@index([orderId, course, status])
  @@index([orderId, seat])
  @@index([stationId, status])
  @@index([isRush, heldAt])
  @@map("resto_order_items")
}

/// Menu add-ons / modifiers (extra cheese, spicy, size…) — applied at add-to-order
model RestoModifier {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  nameEn     String?  @map("name_en")
  priceDelta Decimal  @default(0) @map("price_delta") @db.Decimal(14, 3)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([companyId, sortOrder])
  @@map("resto_modifiers")
}

enum RestoWaitlistStatus {
  WAITING
  NOTIFIED
  SEATED
  CANCELLED
  NO_SHOW
}

/// Walk-in waitlist — seat opens a dine-in order on a free table
model RestoWaitlistEntry {
  id             String              @id @default(uuid())
  companyId      String              @map("company_id")
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  guestName      String              @map("guest_name")
  phone          String?
  guests         Int                 @default(2)
  quotedMinutes  Int?                @map("quoted_minutes")
  status         RestoWaitlistStatus @default(WAITING)
  notes          String?
  tableId        String?             @map("table_id")
  seatedOrderId  String?             @map("seated_order_id")
  notifiedAt     DateTime?           @map("notified_at")
  /// WHATSAPP | SMS | null
  notifyChannel  String?             @map("notify_channel")
  notifyResult   String?             @map("notify_result")
  notifyAttempts Int                 @default(0) @map("notify_attempts")
  seatedAt       DateTime?           @map("seated_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([companyId, status, createdAt])
  @@map("resto_waitlist")
}

/// 86'd menu items — hidden from floor/menu until cleared
model RestoMenu86 {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, productId])
  @@index([companyId])
  @@map("resto_menu_86")
}
