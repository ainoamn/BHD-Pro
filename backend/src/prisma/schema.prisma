generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: use pooled URL in DATABASE_URL, non-pooled in DIRECT_URL (migrations)
  directUrl = env("DIRECT_URL")
}

// ==================== CORE TABLES ====================

model Company {
  id          String   @id @default(uuid())
  name        String
  crNumber    String?  @map("cr_number")
  vatNumber   String?  @map("vat_number")
  address     String?
  city        String?
  country     String   @default("OM")
  phone       String?
  email       String?
  website     String?
  logo        String?
  plan        String   @default("STARTER")
  planExpiry  DateTime? @map("plan_expiry")
  planStartedAt DateTime? @map("plan_started_at")
  /// null = use plan default; -1 = unlimited
  usersLimitOverride    Int? @map("users_limit_override")
  invoicesLimitOverride Int? @map("invoices_limit_override")
  /// Ongoing subscription discount % (family / early adopter / staff). Applied at every checkout.
  permanentDiscountPct Decimal @default(0) @map("permanent_discount_pct") @db.Decimal(5, 2)
  /// Optional label shown in admin (e.g. "عائلة", "مشترك أول")
  permanentDiscountNote String? @map("permanent_discount_note")
  /// Last subscription expiry reminder email sent (throttle weekly)
  subscriptionReminderSentAt DateTime? @map("subscription_reminder_sent_at")
  isActive    Boolean  @default(true) @map("is_active")
  timezone    String   @default("Asia/Muscat")
  currency    String   @default("OMR")
  language    String   @default("ar")
  fiscalYearStart Int @default(1) @map("fiscal_year_start")

  zatcaConfig Json?   @map("ota_config")
  ftaConfig   Json?   @map("tax_config")
  /// Dual-control / maker-checker settings (PIN hash, action toggles). Null = secure defaults.
  securityConfig Json? @map("security_config")
  /// POS cashier commission + customer loyalty points (JSON).
  incentivesConfig Json? @map("incentives_config")
  /// Restaurant ops config (day-part hour windows, etc.). Null = defaults.
  restoConfig Json? @map("resto_config")

  /// Explicit bind between Hisaby Accounting and Hisaby POS
  posLinkedAt DateTime? @map("pos_linked_at")
  posIntegrationKeyHash String? @map("pos_integration_key_hash")
  posIntegrationKeyPrefix String? @map("pos_integration_key_prefix")
  /// POS sells only products assigned/stocked in this warehouse (sector separation)
  posWarehouseId String? @map("pos_warehouse_id")
  posWarehouse   Warehouse? @relation("CompanyPosWarehouse", fields: [posWarehouseId], references: [id], onDelete: SetNull)

  /// Explicit bind for Hisaby Restaurants (F&B) with Accounting / POS
  restoLinkedAt DateTime? @map("resto_linked_at")
  restoIntegrationKeyHash String? @map("resto_integration_key_hash")
  restoIntegrationKeyPrefix String? @map("resto_integration_key_prefix")
  /// Restaurants menu/sales scoped to this warehouse only
  restoWarehouseId String? @map("resto_warehouse_id")
  restoWarehouse   Warehouse? @relation("CompanyRestoWarehouse", fields: [restoWarehouseId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users       User[]
  contacts    Contact[]
  products    Product[]
  invoices    Invoice[]
  journals    Journal[]
  accounts    Account[]
  warehouses  Warehouse[]
  paymentGateways CompanyPaymentGateway[]
  billingInvoices BillingInvoice[]
  branches      Branch[]
  costCenters   CostCenter[]
  projects      Project[]
  employees     Employee[]
  payrollRuns   PayrollRun[]
  fixedAssets   FixedAsset[]
  bankAccounts  BankAccount[]
  bankStatementLines BankStatementLine[]
  purchaseOrders PurchaseOrder[]
  scheduledInvoices ScheduledInvoice[]
  accountingPeriods AccountingPeriod[]
  taxRates TaxRate[]
  deliveryNotes DeliveryNote[]
  stockCounts StockCount[]
  apiKeys CompanyApiKey[]
  employeeClaims EmployeeClaim[]
  documentTemplates DocumentTemplate[]
  customFieldDefinitions CustomFieldDefinition[]
  exchangeRates ExchangeRate[]
  posDrafts     PosDraft[]
  approvalRequests ApprovalRequest[]
  posShifts     PosShift[]
  posCashMovements PosCashMovement[]
  dualControlOtps DualControlOtp[]
  recurringCommitments RecurringCommitment[]
  attachments Attachment[]
  managementAlerts ManagementAlert[]
  managerReportSubscriptions ManagerReportSubscription[]
  customerDisputes CustomerDispute[]
  cashierCommissionLedger CashierCommissionLedger[]
  loyaltyPointsLedger LoyaltyPointsLedger[]
  restoZones RestoZone[]
  restoTables RestoTable[]
  restoStations RestoStation[]
  restoOrders RestoOrder[]
  restoProductStations RestoProductStation[]
  restoReservations RestoReservation[]
  restoRecipes RestoRecipe[]
  restoModifiers RestoModifier[]
  restoWaitlist RestoWaitlistEntry[]
  restoMenu86 RestoMenu86[]
  restoServerSections RestoServerSection[]

  @@index([vatNumber])
  @@index([crNumber])
  @@index([isActive])
  @@map("companies")
}

model User {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  email       String   @unique
  username    String?  @unique
  /// Null for Google-only accounts
  password    String?
  googleId    String?  @unique @map("google_id")
  avatar      String?
  phone       String?
  role        UserRole @default(ACCOUNTANT)
  permissions Json?
  inviteToken String?  @unique @map("invite_token")
  inviteExpiresAt DateTime? @map("invite_expires_at")
  inviteAcceptedAt DateTime? @map("invite_accepted_at")
  mustCompleteProfile Boolean @default(false) @map("must_complete_profile")
  reportSubscriptions ManagerReportSubscription[] @relation("ManagerReportUser")
  reportSubscriptionsCreated ManagerReportSubscription[] @relation("ManagerReportCreatedBy")

  isActive    Boolean  @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  loginAttempts Int    @default(0) @map("login_attempts")
  lockedUntil DateTime? @map("locked_until")
  twoFactorSecret  String?  @map("2fa_secret")
  twoFactorEnabled Boolean  @default(false) @map("2fa_enabled")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdInvoices Invoice[] @relation("CreatedBy")
  createdJournals Journal[] @relation("CreatedBy")
  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrdersCreated")
  scheduledInvoicesCreated ScheduledInvoice[] @relation("ScheduledInvoicesCreated")
  deliveryNotesCreated DeliveryNote[] @relation("DeliveryNotesCreated")
  stockCountsCreated StockCount[] @relation("StockCountsCreated")
  lockedPeriods AccountingPeriod[] @relation("PeriodLockedBy")
  auditLogs   AuditLog[]
  sessions    Session[]
  apiKeysCreated CompanyApiKey[] @relation("ApiKeysCreated")
  employeeClaimsCreated EmployeeClaim[] @relation("EmployeeClaimsCreated")
  posDraftsCreated PosDraft[] @relation("PosDraftsCreated")
  approvalRequestsRequested ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalRequestsDecided   ApprovalRequest[] @relation("ApprovalDecidedBy")
  posShiftsOpened PosShift[] @relation("PosShiftOpenedBy")
  posShiftsClosed PosShift[] @relation("PosShiftClosedBy")
  posCashMovementsCreated PosCashMovement[] @relation("PosCashMovementCreatedBy")
  dualControlOtpsRequested DualControlOtp[] @relation("DualControlOtpRequestedBy")
  cashierCommissionLedger CashierCommissionLedger[] @relation("CashierCommissionUser")
  cashierCommissionCreated CashierCommissionLedger[] @relation("CashierCommissionCreatedBy")
  restoOrdersOpened RestoOrder[] @relation("RestoOrderOpenedBy")
  restoOrdersTipAssignee RestoOrder[] @relation("RestoOrderTipAssignee")
  restoServerSections RestoServerSection[] @relation("RestoServerSectionUser")

  /// Home warehouse for POS cashiers — auto-selected; managers may switch freely
  defaultWarehouseId String? @map("default_warehouse_id")
  defaultWarehouse   Warehouse? @relation("UserDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([email])
  @@index([username])
  @@index([role])
  @@index([defaultWarehouseId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model CompanyApiKey {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  keyPrefix   String    @map("key_prefix")
  keyHash     String    @unique @map("key_hash")

  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("ApiKeysCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([keyPrefix])
  @@map("company_api_keys")
}

// ==================== ACCOUNTING TABLES ====================

model Account {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code        String
  name        String
  nameEn      String?  @map("name_en")
  type        AccountType
  category    AccountCategory
  parentId    String?  @map("parent_id")
  parent      Account? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[] @relation("AccountHierarchy")

  openingBalance Decimal @default(0) @map("opening_balance")
  currentBalance Decimal @default(0) @map("current_balance")

  isActive    Boolean  @default(true) @map("is_active")
  isBank      Boolean  @default(false) @map("is_bank")
  bankAccount String?  @map("bank_account")
  bankName    String?  @map("bank_name")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  journalLines JournalLine[]
  fixedAssets  FixedAsset[]
  bankAccounts BankAccount[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([type])
  @@index([category])
  @@map("accounts")
}

model Journal {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  number      String
  date        DateTime
  description String?
  reference   String?

  totalDebit  Decimal  @map("total_debit")
  totalCredit Decimal  @map("total_credit")
  isBalanced  Boolean  @default(false) @map("is_balanced")

  createdById String   @map("created_by_id")
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lines       JournalLine[]
  invoicePosting Invoice? @relation("InvoiceGlJournal")
  paymentPosting Payment? @relation("PaymentGlJournal")
  payrollAccrualPostings PayrollRun[] @relation("PayrollAccrualJournal")
  payrollPaymentPostings PayrollRun[] @relation("PayrollPaymentJournal")
  claimAccrualPostings EmployeeClaim[] @relation("ClaimAccrualJournal")
  claimPaymentPostings EmployeeClaim[] @relation("ClaimPaymentJournal")
  posCashMovements PosCashMovement[] @relation("PosCashMovementJournal")

  @@index([companyId])
  @@index([date])
  @@index([number])
  @@map("journals")
}

model AccountingPeriod {
  id         String    @id @default(uuid())
  companyId  String    @map("company_id")
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  year       Int
  month      Int

  isLocked   Boolean   @default(false) @map("is_locked")
  lockedAt   DateTime? @map("locked_at")
  lockedById String?   @map("locked_by_id")
  lockedBy   User?     @relation("PeriodLockedBy", fields: [lockedById], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, year, month])
  @@index([companyId])
  @@map("accounting_periods")
}

model TaxRate {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code       String
  name       String
  nameEn     String?  @map("name_en")
  rate       Decimal  @default(5)
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("tax_rates")
}

model DocumentTemplate {
  id          String               @id @default(uuid())
  companyId   String               @map("company_id")
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type        DocumentTemplateType
  name        String
  headerText  String?              @map("header_text")
  footerText  String?              @map("footer_text")
  isDefault   Boolean              @default(false) @map("is_default")
  isActive    Boolean              @default(true) @map("is_active")

  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([companyId, type])
  @@map("document_templates")
}

model CustomFieldDefinition {
  id          String            @id @default(uuid())
  companyId   String            @map("company_id")
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  entityType  CustomFieldEntity @map("entity_type")
  key         String
  label       String
  labelEn     String?           @map("label_en")
  fieldType   CustomFieldType   @map("field_type")
  optionsJson Json?             @map("options_json")
  sortOrder   Int               @default(0) @map("sort_order")
  isRequired  Boolean           @default(false) @map("is_required")
  isActive    Boolean           @default(true) @map("is_active")

  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([companyId, entityType, key])
  @@index([companyId, entityType])
  @@map("custom_field_definitions")
}

model ExchangeRate {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal
  date         DateTime @db.Date
  notes        String?

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([companyId, fromCurrency, toCurrency, date])
  @@index([companyId])
  @@index([date])
  @@map("exchange_rates")
}

model JournalLine {
  id          String   @id @default(uuid())
  journalId   String   @map("journal_id")
  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  accountId   String   @map("account_id")
  account     Account  @relation(fields: [accountId], references: [id])

  description String?
  debit       Decimal  @default(0)
  credit      Decimal  @default(0)
  costCenterId String? @map("cost_center_id")
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])
  projectId    String? @map("project_id")
  project      Project? @relation(fields: [projectId], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([journalId])
  @@index([accountId])
  @@index([costCenterId])
  @@index([projectId])
  @@map("journal_lines")
}

model Branch {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String
  name         String
  nameEn       String?  @map("name_en")
  address      String?
  city         String?
  phone        String?
  isHeadOffice Boolean  @default(false) @map("is_head_office")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employees    Employee[]
  projects     Project[]
  costCenters  CostCenter[]
  fixedAssets  FixedAsset[]
  bankAccounts BankAccount[]
  payrollRuns  PayrollRun[]
  warehouses   Warehouse[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model CostCenter {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    String?  @map("branch_id")
  branch      Branch?  @relation(fields: [branchId], references: [id])
  code        String
  name        String
  nameEn      String?  @map("name_en")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  journalLines JournalLine[]
  projects     Project[]
  invoices     Invoice[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("cost_centers")
}

model Project {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      String?       @map("branch_id")
  branch        Branch?       @relation(fields: [branchId], references: [id])
  costCenterId  String?       @map("cost_center_id")
  costCenter    CostCenter?   @relation(fields: [costCenterId], references: [id])
  code          String
  name          String
  nameEn        String?       @map("name_en")
  description   String?
  startDate     DateTime?     @map("start_date")
  endDate       DateTime?     @map("end_date")
  budget        Decimal       @default(0)
  status        ProjectStatus @default(ACTIVE)
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  journalLines  JournalLine[]
  invoices      Invoice[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("projects")
}

model Employee {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId       String?  @map("branch_id")
  branch         Branch?  @relation(fields: [branchId], references: [id])
  employeeNumber String   @map("employee_number")
  name           String
  nameEn         String?  @map("name_en")
  email          String?
  phone          String?
  jobTitle       String?  @map("job_title")
  department     String?
  baseSalary     Decimal  @default(0) @map("base_salary")
  hireDate       DateTime? @map("hire_date")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  payrollLines   PayrollLine[]
  claims         EmployeeClaim[]

  @@unique([companyId, employeeNumber])
  @@index([companyId])
  @@map("employees")
}

model PayrollRun {
  id          String        @id @default(uuid())
  companyId   String        @map("company_id")
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    String?       @map("branch_id")
  branch      Branch?       @relation(fields: [branchId], references: [id])
  number      String
  periodMonth Int           @map("period_month")
  periodYear  Int           @map("period_year")
  date        DateTime      @default(now())
  status      PayrollStatus @default(DRAFT)
  totalNet    Decimal       @default(0) @map("total_net")
  notes       String?

  paidAt         DateTime?      @map("paid_at")
  paymentMethod  PaymentMethod? @map("payment_method")
  bankAccountId  String?        @map("bank_account_id")
  bankAccount    BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  glAccrualJournalId String?  @unique @map("gl_accrual_journal_id")
  glAccrualJournal   Journal? @relation("PayrollAccrualJournal", fields: [glAccrualJournalId], references: [id])
  glPaymentJournalId String?  @unique @map("gl_payment_journal_id")
  glPaymentJournal   Journal? @relation("PayrollPaymentJournal", fields: [glPaymentJournalId], references: [id])

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  lines       PayrollLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@map("payroll_runs")
}

model PayrollLine {
  id           String     @id @default(uuid())
  payrollRunId String     @map("payroll_run_id")
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String     @map("employee_id")
  employee     Employee   @relation(fields: [employeeId], references: [id])
  baseSalary   Decimal    @default(0) @map("base_salary")
  allowances   Decimal    @default(0)
  deductions   Decimal    @default(0)
  netSalary    Decimal    @default(0) @map("net_salary")

  @@index([payrollRunId])
  @@index([employeeId])
  @@map("payroll_lines")
}

model EmployeeClaim {
  id          String              @id @default(uuid())
  companyId   String              @map("company_id")
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  number      String
  date        DateTime
  employeeId  String              @map("employee_id")
  employee    Employee            @relation(fields: [employeeId], references: [id])

  status      EmployeeClaimStatus @default(DRAFT)
  total       Decimal             @default(0)
  notes       String?
  rejectReason String?            @map("reject_reason")

  submittedAt DateTime?           @map("submitted_at")
  approvedAt  DateTime?           @map("approved_at")
  paidAt      DateTime?           @map("paid_at")
  rejectedAt  DateTime?           @map("rejected_at")

  paymentMethod PaymentMethod? @map("payment_method")
  bankAccountId String?        @map("bank_account_id")
  bankAccount   BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  glAccrualJournalId String?  @unique @map("gl_accrual_journal_id")
  glAccrualJournal   Journal? @relation("ClaimAccrualJournal", fields: [glAccrualJournalId], references: [id])
  glPaymentJournalId String?  @unique @map("gl_payment_journal_id")
  glPaymentJournal   Journal? @relation("ClaimPaymentJournal", fields: [glPaymentJournalId], references: [id])

  createdById String              @map("created_by_id")
  createdBy   User                @relation("EmployeeClaimsCreated", fields: [createdById], references: [id])

  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  lines       EmployeeClaimLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("employee_claims")
}

model EmployeeClaimLine {
  id          String        @id @default(uuid())
  claimId     String        @map("claim_id")
  claim       EmployeeClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  description String
  amount      Decimal
  category    String?
  receiptRef  String?       @map("receipt_ref")

  @@index([claimId])
  @@map("employee_claim_lines")
}

model FixedAsset {
  id                String        @id @default(uuid())
  companyId         String        @map("company_id")
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId          String?       @map("branch_id")
  branch            Branch?       @relation(fields: [branchId], references: [id])
  accountId         String?       @map("account_id")
  account           Account?      @relation(fields: [accountId], references: [id])
  code              String
  name              String
  nameEn            String?       @map("name_en")
  category          AssetCategory @default(OTHER)
  purchaseDate      DateTime?     @map("purchase_date")
  purchaseCost      Decimal       @default(0) @map("purchase_cost")
  currentValue      Decimal       @default(0) @map("current_value")
  depreciationRate  Decimal       @default(0) @map("depreciation_rate")
  location          String?
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("fixed_assets")
}

model BankAccount {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId       String?  @map("branch_id")
  branch         Branch?  @relation(fields: [branchId], references: [id])
  accountId      String?  @map("account_id")
  glAccount      Account? @relation(fields: [accountId], references: [id])
  name           String
  bankName       String   @map("bank_name")
  accountNumber  String   @map("account_number")
  iban           String?
  currency       String   @default("OMR")
  openingBalance Decimal  @default(0) @map("opening_balance")
  currentBalance Decimal  @default(0) @map("current_balance")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  statementLines BankStatementLine[]
  payrollRuns    PayrollRun[]
  employeeClaims EmployeeClaim[]
  payments       Payment[]
  commitments    RecurringCommitment[]

  @@index([companyId])
  @@map("bank_accounts")
}

model BankStatementLine {
  id            String      @id @default(uuid())
  companyId     String      @map("company_id")
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccountId String      @map("bank_account_id")
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  date          DateTime
  description   String
  reference     String?
  /// Positive = deposit / credit; negative = withdrawal / debit
  amount        Decimal
  isReconciled  Boolean     @default(false) @map("is_reconciled")
  reconciledAt  DateTime?   @map("reconciled_at")

  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([bankAccountId])
  @@index([date])
  @@map("bank_statement_lines")
}

// ==================== INVOICE TABLES ====================

model Invoice {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  number      String
  type        InvoiceType @default(SALES)

  contactId   String   @map("contact_id")
  contact     Contact  @relation(fields: [contactId], references: [id])

  date        DateTime
  dueDate     DateTime @map("due_date")

  subtotal    Decimal 
  discount    Decimal  @default(0)
  taxRate     Decimal  @default(5) @map("tax_rate")
  taxAmount   Decimal  @map("tax_amount")
  total       Decimal 
  paidAmount  Decimal  @default(0) @map("paid_amount")

  /// Document currency (defaults to company currency)
  currency       String   @default("OMR")
  /// Rate from document currency → company base currency
  exchangeRate   Decimal  @default(1) @map("exchange_rate")
  /// Total in document currency when currency differs from company base
  foreignTotal   Decimal? @map("foreign_total")

  status      InvoiceStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  isCash      Boolean  @default(false) @map("is_cash")

  vatUuid     String?  @map("vat_uuid") @unique
  xmlContent  String?  @map("xml_content")
  qrCode      String?  @map("qr_code")
  /// Short public code for phone-scannable authenticity QR (/v/CODE)
  publicVerifyCode String? @unique @map("public_verify_code")
  hash        String?
  signedXml   String?  @map("signed_xml")
  clearedAt   DateTime? @map("cleared_at")

  notes       String?
  terms       String?

  costCenterId String?     @map("cost_center_id")
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])
  projectId    String?     @map("project_id")
  project      Project?    @relation(fields: [projectId], references: [id])

  glJournalId String?  @unique @map("gl_journal_id")
  glJournal   Journal? @relation("InvoiceGlJournal", fields: [glJournalId], references: [id])

  createdById String   @map("created_by_id")
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])

  /// Optional POS cash-drawer shift this sale belongs to
  posShiftId  String?   @map("pos_shift_id")
  posShift    PosShift? @relation(fields: [posShiftId], references: [id], onDelete: SetNull)

  /// Warehouse used for this POS sale (home or remote)
  posWarehouseId String? @map("pos_warehouse_id")
  posWarehouse   Warehouse? @relation("InvoicePosWarehouse", fields: [posWarehouseId], references: [id], onDelete: SetNull)
  /// null = stock deducted at sale; PENDING = remote sale awaiting later fulfillment; DONE = fulfilled
  posFulfillmentStatus String? @map("pos_fulfillment_status")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items       InvoiceItem[]
  payments    Payment[]
  customerDisputes CustomerDispute[]

  customFieldsJson Json @default("{}") @map("custom_fields_json")

  @@unique([companyId, number])
  @@index([companyId])
  @@index([contactId])
  @@index([status])
  @@index([date])
  @@index([costCenterId])
  @@index([projectId])
  @@index([vatUuid])
  @@index([isCash])
  @@index([posShiftId])
  @@index([posWarehouseId])
  @@index([posFulfillmentStatus])
  /// Dashboard / reports: month & cashflow aggregates by type+date
  @@index([companyId, type, date])
  /// Dashboard: pending collection + stale PAID repair
  @@index([companyId, status, paymentStatus])
  /// Recent invoices + POS day buckets
  @@index([companyId, createdAt])
  /// POS today sales / voids (isCash + createdAt)
  @@index([companyId, type, isCash, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId   String?  @map("product_id")
  product     Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Decimal 
  unitPrice   Decimal  @map("unit_price")
  discount    Decimal  @default(0)
  taxRate     Decimal  @default(5) @map("tax_rate")
  taxAmount   Decimal  @map("tax_amount")
  total       Decimal
  /// Optional line note (POS cart note, kitchen, etc.)
  notes       String?

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount      Decimal 
  method      PaymentMethod
  reference   String?
  date        DateTime
  notes       String?

  bankAccountId String?      @map("bank_account_id")
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  glJournalId String?  @unique @map("gl_journal_id")
  glJournal   Journal? @relation("PaymentGlJournal", fields: [glJournalId], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@index([bankAccountId])
  /// Dashboard: today's payments by date then join invoice
  @@index([date])
  @@map("payments")
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  number      String
  contactId   String   @map("contact_id")
  contact     Contact  @relation(fields: [contactId], references: [id])

  date        DateTime
  expectedDate DateTime? @map("expected_date")

  subtotal    Decimal
  discount    Decimal  @default(0)
  taxRate     Decimal  @default(5) @map("tax_rate")
  taxAmount   Decimal  @map("tax_amount")
  total       Decimal

  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?

  createdById String   @map("created_by_id")
  createdBy   User     @relation("PurchaseOrdersCreated", fields: [createdById], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items       PurchaseOrderItem[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([contactId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String?  @map("product_id")
  product     Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Decimal
  unitPrice   Decimal  @map("unit_price")
  discount    Decimal  @default(0)
  taxRate     Decimal  @default(5) @map("tax_rate")
  taxAmount   Decimal  @map("tax_amount")
  total       Decimal

  @@index([orderId])
  @@map("purchase_order_items")
}

model ScheduledInvoice {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  contactId   String   @map("contact_id")
  contact     Contact  @relation(fields: [contactId], references: [id])

  frequency   ScheduleFrequency @default(MONTHLY)
  nextDate    DateTime @map("next_date")
  lastGeneratedAt DateTime? @map("last_generated_at")
  isActive    Boolean  @default(true) @map("is_active")

  subtotal    Decimal
  discount    Decimal  @default(0)
  taxRate     Decimal  @default(5) @map("tax_rate")
  taxAmount   Decimal  @map("tax_amount")
  total       Decimal
  notes       String?

  createdById String   @map("created_by_id")
  createdBy   User     @relation("ScheduledInvoicesCreated", fields: [createdById], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items       ScheduledInvoiceItem[]

  @@index([companyId])
  @@index([contactId])
  @@index([nextDate])
  @@map("scheduled_invoices")
}

model ScheduledInvoiceItem {
  id          String   @id @default(uuid())
  scheduleId  String   @map("schedule_id")
  schedule    ScheduledInvoice @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  productId   String?  @map("product_id")
  product     Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Decimal
  unitPrice   Decimal  @map("unit_price")
  discount    Decimal  @default(0)
  taxRate     Decimal  @default(5) @map("tax_rate")
  taxAmount   Decimal  @map("tax_amount")
  total       Decimal

  @@index([scheduleId])
  @@map("scheduled_invoice_items")
}

// ==================== INVENTORY TABLES ====================

model Product {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sku         String
  name        String
  nameEn      String?  @map("name_en")
  description String?
  category    String
  barcode     String?

  costPrice   Decimal  @map("cost_price")
  salePrice   Decimal  @map("sale_price")

  quantity    Decimal  @default(0)
  minQuantity Decimal  @default(5) @map("min_quantity")
  maxQuantity Decimal? @map("max_quantity")
  reorderPoint Decimal @default(10) @map("reorder_point")

  unit        String   @default("piece")
  warehouseId String?  @map("warehouse_id")
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  isActive    Boolean  @default(true) @map("is_active")
  isTracked   Boolean  @default(true) @map("is_tracked")
  /// POS: prompt for kg weight instead of piece qty
  soldByWeight Boolean @default(false) @map("sold_by_weight")

  images      String[]
  /// EU14-style allergen codes (gluten, milk, nuts, …)
  allergens   String[] @default([])
  /// Dietary / lifestyle tags (halal, vegan, spicy, …)
  dietaryTags String[] @default([]) @map("dietary_tags")
  /// Day-part availability: breakfast|lunch|dinner|late — empty = all day
  dayParts    String[] @default([]) @map("day_parts")
  /// Optional price overrides per day-part: { "lunch": 3.5, ... } — missing = salePrice
  dayPartPrices Json @default("{}") @map("day_part_prices")

  customFieldsJson Json @default("{}") @map("custom_fields_json")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  invoiceItems InvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]
  scheduledInvoiceItems ScheduledInvoiceItem[]
  stockMovements StockMovement[]
  deliveryNoteItems DeliveryNoteItem[]
  stockCountLines StockCountLine[]
  warehouseStocks WarehouseStock[]
  restoRecipeAsDish RestoRecipe?
  restoRecipeComponents RestoRecipeItem[] @relation("RestoRecipeComponent")

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId])
  @@index([sku])
  @@index([barcode])
  @@index([category])
  /// POS catalog + dashboard product counts
  @@index([companyId, isActive])
  /// POS incremental syncStock?since=
  @@index([companyId, updatedAt])
  @@map("products")
}

model Warehouse {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  nameEn       String?  @map("name_en")
  code        String
  address     String?
  /// Sector: keep RETAIL vs RESTAURANT stock/catalogs separate
  sector      WarehouseSector @default(GENERAL)
  branchId    String?  @map("branch_id")
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")

  products    Product[]
  stockMovements StockMovement[]
  deliveryNotes DeliveryNote[]
  stockCounts StockCount[]
  warehouseStocks WarehouseStock[]
  posShifts PosShift[]
  companiesPosDefault   Company[] @relation("CompanyPosWarehouse")
  companiesRestoDefault Company[] @relation("CompanyRestoWarehouse")
  usersDefault          User[]    @relation("UserDefaultWarehouse")
  invoicesPos           Invoice[] @relation("InvoicePosWarehouse")

  @@unique([companyId, code])
  @@index([companyId, sector])
  @@index([branchId])
  @@map("warehouses")
}

model WarehouseStock {
  id          String    @id @default(uuid())
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Decimal   @default(0)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("warehouse_stocks")
}

model StockMovement {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String   @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  type        MovementType
  quantity    Decimal 
  unitCost    Decimal  @map("unit_cost")
  reference   String?
  notes       String?

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([warehouseId])
  @@map("stock_movements")
}

model StockCount {
  id            String           @id @default(uuid())
  companyId     String           @map("company_id")
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  number        String
  date          DateTime
  warehouseId   String?          @map("warehouse_id")
  warehouse     Warehouse?       @relation(fields: [warehouseId], references: [id])

  status        StockCountStatus @default(DRAFT)
  notes         String?
  completedAt   DateTime?        @map("completed_at")

  createdById   String           @map("created_by_id")
  createdBy     User             @relation("StockCountsCreated", fields: [createdById], references: [id])

  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  lines         StockCountLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([date])
  @@map("stock_counts")
}

model StockCountLine {
  id           String     @id @default(uuid())
  stockCountId String     @map("stock_count_id")
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  productId    String     @map("product_id")
  product      Product    @relation(fields: [productId], references: [id])

  systemQty    Decimal    @map("system_qty")
  countedQty   Decimal    @map("counted_qty")

  @@index([stockCountId])
  @@index([productId])
  @@map("stock_count_lines")
}

// ==================== CONTACT TABLES ====================

model Contact {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type        ContactType
  name        String
  nameEn      String?  @map("name_en")

  taxId       String?  @map("tax_id")
  crNumber    String?  @map("cr_number")

  email       String?
  phone       String?
  phone2      String?
  fax         String?

  address     String?
  city        String?
  country     String   @default("OM")
  zipCode     String?  @map("zip_code")

  openingBalance Decimal @default(0) @map("opening_balance")
  currentBalance Decimal @default(0) @map("current_balance")
  creditLimit Decimal? @map("credit_limit")
  paymentTerms Int?     @map("payment_terms")
  loyaltyPoints Decimal @default(0) @db.Decimal(14, 3) @map("loyalty_points")

  website     String?
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  customFieldsJson Json @default("{}") @map("custom_fields_json")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  invoices    Invoice[]
  purchaseOrders PurchaseOrder[]
  scheduledInvoices ScheduledInvoice[]
  deliveryNotes DeliveryNote[]
  loyaltyPointsLedger LoyaltyPointsLedger[]
  restoOrders RestoOrder[]

  @@index([companyId])
  @@index([type])
  @@index([taxId])
  /// Dashboard customer count
  @@index([companyId, isActive, type])
  @@map("contacts")
}

model DeliveryNote {
  id            String              @id @default(uuid())
  companyId     String              @map("company_id")
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  number        String
  date          DateTime
  contactId     String              @map("contact_id")
  contact       Contact             @relation(fields: [contactId], references: [id])
  warehouseId   String?             @map("warehouse_id")
  warehouse     Warehouse?          @relation(fields: [warehouseId], references: [id])

  status        DeliveryNoteStatus  @default(DRAFT)
  notes         String?

  deliveredAt   DateTime?           @map("delivered_at")

  createdById   String              @map("created_by_id")
  createdBy     User                @relation("DeliveryNotesCreated", fields: [createdById], references: [id])

  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  items         DeliveryNoteItem[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([contactId])
  @@index([date])
  @@map("delivery_notes")
}

model DeliveryNoteItem {
  id              String       @id @default(uuid())
  deliveryNoteId  String       @map("delivery_note_id")
  deliveryNote    DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  productId       String?      @map("product_id")
  product         Product?     @relation(fields: [productId], references: [id])

  description     String
  quantity        Decimal
  unit            String       @default("pcs")

  @@index([deliveryNoteId])
  @@map("delivery_note_items")
}

// ==================== AUDIT & LOGS ====================

model AuditLog {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id])

  action      String
  entity      String
  entityId    String?  @map("entity_id")
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

