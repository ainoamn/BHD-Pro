model PlanOffer {
  id           String    @id @default(uuid())
  plan         String
  nameAr       String    @map("name_ar")
  nameEn       String    @map("name_en")
  discountPct  Decimal   @default(0) @map("discount_pct") @db.Decimal(5, 2)
  promoCode    String?   @unique @map("promo_code")
  isActive     Boolean   @default(true) @map("is_active")
  startsAt     DateTime? @map("starts_at")
  endsAt       DateTime? @map("ends_at")
  monthlyPrice Decimal?  @map("monthly_price") @db.Decimal(12, 3)
  yearlyPrice  Decimal?  @map("yearly_price") @db.Decimal(12, 3)
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([plan])
  @@map("plan_offers")
