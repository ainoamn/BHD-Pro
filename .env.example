# BHD Pro - Environment Variables
# Copy to backend/.env and frontend/.env.local as needed.
# NEVER commit real secrets.

# Set to production when deploying — enforces strong JWT / payment secret checks
NODE_ENV=development

# Database
DATABASE_URL=postgresql://qootk:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/qootk_pro?schema=public
# Same as DATABASE_URL locally; on Neon use the non-pooled connection string
DIRECT_URL=postgresql://qootk:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/qootk_pro?schema=public

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_OPENSSL_RAND_BASE64_48
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Encrypt payment gateway secrets at rest (AES-256-GCM) — openssl rand -base64 48
PAYMENT_SECRETS_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_48

# Comma-separated emails allowed to manage platform payment gateways
PLATFORM_ADMIN_EMAILS=you@yourdomain.com

# Roles that must enable TOTP 2FA (default ADMIN,MANAGER). Set to off to disable env policy.
REQUIRE_2FA_ROLES=ADMIN,MANAGER
# Grace days before mutations can be blocked (needs GRACE_FROM). Default 7.
REQUIRE_2FA_GRACE_DAYS=7
# ISO start for the grace clock — required to end the window / enable hard lock.
# REQUIRE_2FA_GRACE_FROM=2026-07-27T00:00:00.000Z
# Block POST/PUT/PATCH/DELETE after grace until 2FA is on (default off).
REQUIRE_2FA_HARD_AFTER_GRACE=off

# Backend
PORT=3001
# Production MUST be your HTTPS frontend origin (not localhost)
# Comma-separated if you use both apex and www
CORS_ORIGIN=http://localhost:3000

# Google Sign-In (same Client ID on backend + frontend)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Frontend — use same-origin proxy so httpOnly cookies work
NEXT_PUBLIC_API_URL=/backend-api
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
# Used by Next.js rewrite in next.config.js
BACKEND_URL=http://localhost:3001

# WhatsApp Cloud API (OTP + receipts). Use WHATSAPP_TOKEN=mock for log-only tests.
WHATSAPP_ENABLED=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Required for first-contact POS receipts (Meta blocks free-form outside 24h window).
# Create Utility template in WhatsApp Manager with body vars:
# {{1}} customer name · {{2}} company · {{3}} invoice # · {{4}} amount · {{5}} view URL
# WHATSAPP_RECEIPT_TEMPLATE=pos_receipt
# WHATSAPP_RECEIPT_TEMPLATE_LANG=ar

# Email notifications (POS receipts / alerts). EMAIL_MODE=mock logs only.
EMAIL_ENABLED=true
EMAIL_MODE=
EMAIL_FROM=Hisaby <noreply@hisaby.pro>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Twilio SMS (POS receipts). TWILIO_MODE=mock logs only.
SMS_ENABLED=true
TWILIO_MODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SoftPOS / terminal tap-to-pay (partner device — not NFC approval badge)
POS_TERMINAL_MODE=hosted
POS_SOFTPOS_DEEP_LINK_TEMPLATE=

# Optional LLM enrichment for AI analytics (HITL only — never auto-posts)
OPENAI_API_KEY=
AI_LLM_API_KEY=
AI_LLM_BASE_URL=
AI_LLM_MODEL=gpt-4o-mini

# OTA live client secret fallback (prefer company zatcaConfig)
OTA_CLIENT_SECRET=

# Attachment storage: dataurl (default) | local | s3
# For production prefer s3 (R2 / MinIO / AWS) — requires @aws-sdk/client-s3 (bundled)
ATTACHMENT_STORAGE=dataurl
ATTACHMENT_LOCAL_DIR=./uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=

# Cookie SameSite: lax (same-site / Next proxy) | none (API on another domain — requires HTTPS)
# COOKIE_SAME_SITE=lax

# Optional Redis — when set: distributed throttle + /health/ready ping
# Leave empty for in-memory throttle (fine for single-instance / local)
REDIS_URL=
# REDIS_URL=redis://:qootk_redis_dev@127.0.0.1:6379

# Optional Sentry (no-ops when unset)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENABLED=true
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_ENABLED=true

# Invite / app links for user onboarding emails
APP_URL=http://localhost:3000
# FRONTEND_URL already listed above — used as fallback for invite links

# Platform payment gateways (subscription billing)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
THAWANI_PUBLISHABLE_KEY=
THAWANI_SECRET_KEY=
THAWANI_WEBHOOK_SECRET=
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
